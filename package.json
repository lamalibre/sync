{
  "name": "@lamalibre/sync",
  "private": true,
  "description": "File synchronization and cloud archive tool — rclone-based bidirectional sync with archive/restore support",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Code Lama Software",
  "repository": {
    "type": "git",
    "url": "https://github.com/lamalibre/sync.git"
  },
  "homepage": "https://github.com/lamalibre/sync",
  "bugs": {
    "url": "https://github.com/lamalibre/sync/issues"
  },
  "keywords": [
    "sync",
    "file-sync",
    "rclone",
    "archive",
    "cloud-storage",
    "portlama",
    "encryption"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint . && pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:server": "pnpm --filter @lamalibre/sync-server dev",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.39.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^17.4.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.32.0"
  }
}
