{
  "name": "@lamalibre/sync-server",
  "version": "0.1.9",
  "description": "Sync server — Fastify REST API for file synchronization and cloud archive management",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Code Lama Software",
  "repository": {
    "type": "git",
    "url": "https://github.com/lamalibre/sync.git",
    "directory": "packages/sync-server"
  },
  "homepage": "https://github.com/lamalibre/sync",
  "bugs": {
    "url": "https://github.com/lamalibre/sync/issues"
  },
  "keywords": [
    "sync",
    "file-sync",
    "rclone",
    "fastify",
    "server"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "bin": {
    "sync-server": "bin/sync-server.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./portlama-plugin.json": "./portlama-plugin.json",
    "./panel.js": "./dist/panel.js"
  },
  "files": [
    "dist",
    "bin",
    "portlama-plugin.json"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "dev": "node --watch-path=src ../../scripts/build.mjs && node dist/index.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@lamalibre/sync-shared": "workspace:*",
    "execa": "^9.5.0",
    "@lamalibre/portlama-tickets": "^0.1.0",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^4.0.2",
    "undici": "^7.24.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
