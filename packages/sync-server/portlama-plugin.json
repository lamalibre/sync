{
  "name": "sync",
  "displayName": "Sync",
  "version": "0.1.14",
  "description": "Bidirectional file synchronization between agents",
  "capabilities": [
    "sync:connect"
  ],
  "packages": {
    "server": "@lamalibre/sync-server",
    "agent": "@lamalibre/sync-agent"
  },
  "panel": {
    "pages": [
      {
        "path": "/dashboard",
        "title": "Dashboard",
        "icon": "layout-dashboard"
      },
      {
        "path": "/storage",
        "title": "Storage",
        "icon": "hard-drive"
      },
      {
        "path": "/agents",
        "title": "Agents",
        "icon": "monitor"
      },
      {
        "path": "/preview",
        "title": "Preview",
        "icon": "eye"
      },
      {
        "path": "/trash",
        "title": "Trash",
        "icon": "trash-2"
      },
      {
        "path": "/settings",
        "title": "Settings",
        "icon": "settings"
      }
    ]
  },
  "modes": [
    "server",
    "agent",
    "local"
  ],
  "config": {}
}
